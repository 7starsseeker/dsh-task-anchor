{
  "name": "dsh-task-anchor",
  "version": "0.2.3",
  "description": "Keep the running task anchored when a mid-turn user message arrives: a prompt contract, a suspended-plan anchor that survives compaction, and a turn-stopping guard that makes unfinished work explicit instead of silently dropped.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/policy.js && node --check lib/store.js"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "RELEASING.md",
    "RELEASING.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "steering",
    "interjection",
    "task-anchor",
    "goal-drift",
    "context-compaction",
    "zero-dependency"
  ],
  "license": "Apache-2.0",
  "author": "7starsseeker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7starsseeker/dsh-task-anchor.git"
  },
  "homepage": "https://github.com/7starsseeker/dsh-task-anchor#readme",
  "bugs": {
    "url": "https://github.com/7starsseeker/dsh-task-anchor/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
